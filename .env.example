# Register: Umgebungsvariablen
# Lokal: diese Datei nach .env.local kopieren und ausfüllen. In Vercel: Project Settings > Environment Variables.
# Niemals .env.local committen (steht in .gitignore).

# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Geheim, nur serverseitig. Wird vom Scheduler und für die Test-E-Mail benutzt.
SUPABASE_SECRET_KEY=sb_secret_...

# Resend (resend.com > API Keys, Berechtigung "Sending access")
RESEND_API_KEY=re_...
# Ohne eigene Domain: onboarding@resend.dev. Dann gehen E-Mails nur an die Adresse deines Resend-Kontos.
EMAIL_FROM=Register <onboarding@resend.dev>

# Langes Zufallsgeheimnis, schützt den Scheduler-Endpunkt. Erzeugen z.B. mit: openssl rand -hex 32
CRON_SECRET=

# Öffentliche Adresse der App, wird für Links in E-Mails benutzt (ohne Schrägstrich am Ende)
APP_URL=https://dein-projekt.vercel.app

# Nur diese E-Mail-Adresse darf sich anmelden (zusätzliche Absicherung)
ALLOWED_EMAIL=

# Empfänger für Systemwarnungen (Scheduler steht, Datenbank nicht erreichbar).
# Ohne eigene Resend-Domain muss das die Adresse deines Resend-Kontos sein.
ALERT_EMAIL=
